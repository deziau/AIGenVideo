# Claude: analyzes the reference video + your text and writes the generation prompt.
ANTHROPIC_API_KEY=
# Runway: renders the new video (gen4_aleph video-to-video). Without it, the app
# falls back to a local "preview" render so you can still try the flow.
RUNWAYML_API_SECRET=
# Optional overrides
# AIGV_DATA_DIR=./data
# AIGV_MAX_SIDE=1280
# AIGV_REFERENCE_SECONDS=5
